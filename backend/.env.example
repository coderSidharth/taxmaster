# Copy this file to ".env" in the backend/ folder and fill in real values.
# The .env file is git-ignored and must never be committed.

# MongoDB connection string (local or MongoDB Atlas)
dbCredential=mongodb://127.0.0.1:27017/taxstore

# Secret used to sign JWT auth tokens (use a long random string)
JWT_SECRET=change-this-to-a-long-random-secret

# Gmail account used to send reminder emails.
# Use a Google "App Password" (not your normal password) with 2FA enabled.
# If these are left blank, the app still runs and saves reminders,
# it just skips actually sending the email.
EMAIL=youraddress@gmail.com
PASSWORD=your-16-char-app-password
